    1  whoami           # ваше имя
    2  sudo whoami      # root
    3  getenforce       # Enforcing ✅
    4  systemctl status # работает ✅
    5  journalctl -n 5  # показывает логи ✅
    6  sudo systemctl --no-pager status
    7  # ВЫЙДИТЕ из Lima (exit), затем в терминале Mac:
    8  limactl snapshot create fedora --tag clean
    9  # ВЫЙДИТЕ из Lima (exit), затем в терминале Mac:
   10  limactl snapshot create fedora --tag clean
   11  exit
   12  su - user1
   13  passwd
   14  limactl shell fedora
   15  # Проверяем, свободен ли UID 1234
   16  getent passwd 1234
   17  # Создаём группу students
   18  sudo groupadd students
   19  getent group students
   20  # Создаём пользователя user1 с UID 1234
   21  sudo useradd -u 1234 -m -G students -s /bin/bash user1
   22  # Проверяем
   23  id user1
   24  # Задаём пароль (введите, например, User1Pass! и запомните его)
   25  sudo passwd user1
   26  # Настраиваем смену пароля каждые 90 дней
   27  sudo chage -M 90 user1
   28  # Проверяем
   29  sudo chage -l user1
   30  getent passwd 1234
   31  sudo groupadd students
   32  getent group students
   33  sudo useradd -u 1234 -m -G students -s /bin/bash user1
   34  # Создаём пустые файлы (если их нет — они создадутся)
   35  sudo touch /etc/subuid /etc/subgid
   36  # Проверяем, что они есть
   37  ls -l /etc/subuid /etc/subgid
   38  sudo useradd -u 1234 -m -G students -s /bin/bash user1
   39  # Добавляем в конец login.defs строки, отключающие выделение subordinate ID
   40  echo 'SUB_UID_COUNT 0' | sudo tee -a /etc/login.defs
   41  echo 'SUB_GID_COUNT 0' | sudo tee -a /etc/login.defs
   42  # Проверяем, что строки добавились
   43  tail -5 /etc/login.defs
   44  sudo useradd -u 1234 -m -G students -s /bin/bash user1
   45  # Удаляем файлы, которые мешают useradd
   46  sudo rm -f /etc/subuid /etc/subgid
   47  ls -l /etc/subuid /etc/subgid
   48  sudo useradd -u 1234 -m -G students -s /bin/bash user1
   49  id user1
   50  sudo passwd user1
   51  sudo chage -M 90 user1
   52  sudo chage -l user1
   53  sudo find / -perm -4000 -type f 2>/dev/null | tee ~/setuid_files.out
   54  ps -eo pid,ruid,euid,user,comm,args | awk '$3==0 && $2!=0' | tee ~/processes.out
   55  ls -l /etc/shadow
   56  su - user1
   57  sudo stat /home/user1/mycat >> ~/stat.out
   58  stat /home/user1 > ~/stat.out
   59  sudo stat /home/user1/mycat >> ~/stat.out
   60  hostname
   61  ls -l ~/stat.out
   62  cat ~/stat.out
   63  su - user1
   64  /home/user1/mycat /etc/shadow | head -3
   65  exit
   66  sudo cp /usr/bin/cat /home/user1/mycat
   67  sudo chown root:root /home/user1/mycat
   68  sudo chmod 4755 /home/user1/mycat
   69  ls -l /home/user1/mycat
   70  sudo ls -l /home/user1/mycat
   71  su - user1
   72  /home/user1/mycat /etc/shadow | head -5
   73  exit
   74  su - user1
   75  touch /home/user1/testfile
   76  ls -l /home/user1/testfile
   77  chown root:root /home/user1/testfile
   78  exit
   79  hostname
   80  sudo cp /usr/bin/chown /home/user1/mychown
   81  sudo chown root:root /home/user1/mychown
   82  sudo chmod 755 /home/user1/mychown
   83  sudo setcap cap_chown+ep /home/user1/mychown
   84  sudo getcap /home/user1/mychown
   85  su - user1
   86  ls -l /home/user1/testfile
   87  /home/user1/mychown root:root /home/user1/testfile
   88  ls -l /home/user1/testfile
   89  exit
   90  su - user1
   91  sudo getcap /home/user1/mychown > ~/getcap.out
   92  sudo stat /home/user1/mychown >> ~/stat.out
   93  sudo tee /etc/sudoers.d/user1-time > /dev/null <<'EOF'
user1 ALL=(root) /usr/bin/date -s *, /usr/bin/timedatectl set-time *
EOF

   94  sudo chmod 440 /etc/sudoers.d/user1-time
   95  ls -l /etc/sudoers.d/user1-time
   96  sudo ls -l /etc/sudoers.d/
   97  sudo visudo -c
   98  su - user1
   99  sudo cp /etc/sudoers /home/stephan26.guest/sudoers
  100  sudo cp /etc/sudoers.d/user1-time /home/stephan26.guest/sudoers.d-user1-time
  101  sudo chown stephan26:stephan26 /home/stephan26.guest/sudoers /home/stephan26.guest/sudoers.d-user1-time
  102  ls -l /home/stephan26.guest/sudoers /home/stephan26.guest/sudoers.d-user1-time
